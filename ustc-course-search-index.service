[Unit]
Description=Rebuild the USTC iCourse search index
Documentation=file:///srv/ustc-course/app/search/__init__.py
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=icourse
Group=icourse
WorkingDirectory=/srv/ustc-course
Environment=PYTHONPATH=/srv/ustc-course
ExecStart=/usr/bin/python3 -m app.search.builder --quiet
# The builder holds the postings for one collection in memory before packing
# them; reviews peaks around 400 MB.  Nice it down so a rebuild never competes
# with request handling.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
